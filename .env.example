# =====================================================================
# AI 客服系统 - Docker 部署环境变量（docker compose 同目录）
# 复制为 .env 后按需填写；.env 已被 .gitignore 排除，绝不提交
# 注意：本文件只允许变量名和示例值，禁止出现任何真实 Key
# =====================================================================

# DeepSeek API Key（不填则 LLM 走模板降级，系统功能完整可用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LLM 服务（OpenAI 兼容协议）
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT=60

# JWT 签名密钥（生产必须替换为强随机值）
# SECRET_KEY=change-me-to-a-strong-random-secret

# Embedding（容器内默认 local + BAAI/bge-small-zh-v1.5，模型缓存挂载 ./data/hf_cache）
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 仅 EMBEDDING_PROVIDER=openai/auto 且需要 API 向量服务时填写
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# HuggingFace 模型下载镜像（国内网络推荐保持默认）
# HF_ENDPOINT=https://hf-mirror.com

# 日志级别（P4.1）
# LOG_LEVEL=INFO
