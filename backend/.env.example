# DeepSeek API Key（部署时请填入真实密钥，请勿提交到版本库）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LLM 服务（OpenAI 兼容协议，默认 DeepSeek；可切换其他兼容服务）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# JWT 签名密钥（生产必须替换为强随机值）
# SECRET_KEY=change-me-to-a-strong-random-secret

# 数据库（默认 SQLite ./chat.db；P2 切换 MySQL 时配置，如 mysql+pymysql://user:pass@host:3306/ai_chat）
# DATABASE_URL=sqlite:///./chat.db

# ============== P2.1 知识库 ==============
# Embedding provider：
#   local=本地 sentence-transformers 中文模型（推荐，无需 API Key，首次运行自动下载）；
#   auto=有 Key 用 OpenAI 兼容 API，否则本地模型（加载失败降级 hash）；
#   openai=强制 API；hash=强制本地哈希降级（无语义，仅测试用）
EMBEDDING_PROVIDER=local
# local provider 时为 HuggingFace 模型名（首次下载后读本地缓存，完全离线）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# OpenAI 兼容 embeddings 服务（provider=auto/openai 时生效）：
#   硅基流动: https://api.siliconflow.cn/v1 + BAAI/bge-large-zh-v1.5
#   智谱:     https://open.bigmodel.cn/api/paas/v4 + embedding-3
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# Chunk 切分参数
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# 上传限制与存储目录
# KB_MAX_UPLOAD_SIZE=10485760
# KB_UPLOAD_DIR=
# VECTOR_STORE_DIR=

# ============== P2.2 RAG 接入 /chat ==============
# 检索 Top-K 条数（跨全部知识库合并后取前 K）
# RAG_TOP_K=5
# 最低相似度阈值：检索最高分低于该值时不使用 RAG（继续走普通 LLM，避免强行喂无关内容）
# RAG_SIMILARITY_THRESHOLD=0.45
# citation 事件中片段预览的最大长度
# RAG_SNIPPET_MAX_LEN=120

# ============== P3.2 多步 Tool 编排 ==============
# 单次对话最大 Tool 调用次数（防止 Tool 链无限循环）
# MAX_TOOL_STEPS=3

# ============== P4.1 日志 ==============
# 日志级别（开发环境 INFO；排查问题可临时 DEBUG）
# LOG_LEVEL=INFO
