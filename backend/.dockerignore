# 禁止进入镜像的内容（依赖在容器内安装，数据由卷挂载提供）
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# 敏感信息：绝不把 .env 打进镜像（Key 由 compose 环境变量注入）
.env

# 本地数据：由 docker compose 卷挂载提供，不进镜像
*.db
chat.db
uploads/
vector_store/

# 测试与临时文件
verify_*.py
_tmp*
test_*.db
.vector_store_test*
uploads_test*

# 版本控制与文档
.git/
.gitignore
__pycache__/
